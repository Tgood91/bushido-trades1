# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Base RPC Configuration
COINBASE_RPC="https://developer-access-mainnet.base.org"
TENDERLY_WSS="wss://base.gateway.tenderly.co"
FALLBACK_RPC_1="https://1rpc.io/base"
FALLBACK_RPC_2="https://base.api.pocket.network"

# Bushido & Druckenmiller Trading Protocol Parameters
ORCHESTRATOR_MIN_ALIGNMENT_SCORE="70"
ORCHESTRATOR_MAX_SWAP_PCT="10"

# Stanley Druckenmiller Relayer / Agent Key (Kept server-side only)
AGENT_WALLET_KEY=""
